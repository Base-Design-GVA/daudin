{% extends "base.twig" %}

{% block content %}
    <section class="annonce_list mode-projets-neufs part-of-lieu-vie">
        <div class="bien_header container">
            {{ load_nav_menu(fields_footer.acf_fixed_footer.left_menu.slug, "button") }}
        </div>

        <h1 class="container">Nos <span class="colored-label">Projets Neufs</span></h1>

        <div class="filters container">
            <div class="width-placeholder">
                <div class="type_de_bien filter-container">
                    <button type="button" class="button-tdb">
                        <label for="type_bien_radio">Type de bien</label>
                    </button>
                    <div class="hidden-part-tdb">
                        <div class="radios">
                            <div class="input-group">
                                <input type="radio" id="type-all" name="type_bien_radio" data-filter="" value="" checked>
                                <label for="type-all">Tous</label>
                            </div>
                            {% for valeur, type_bien in filters.types_biens %}
                                <div class="input-group">
                                    <input
                                        type="radio"
                                        id="type-{{ loop.index }}"
                                        name="type_bien_radio"
                                        data-filter=".type-{{ valeur }}"
                                        value="{{ valeur }}"
                                    >
                                    <label for="type-{{ loop.index }}">{{ type_bien }}</label>
                                </div>
                            {% endfor %}
                        </div>
                        <input type="hidden" name="filter_type" id="filter_type" readonly value="">
                    </div>
                </div>
            </div>

            <div class="width-placeholder">
                <div class="quartier filter-container">
                    <button class="button-q" type="button">
                        <label for="quartier_radio">Quartier</label>
                    </button>
                    <div class="hidden-part-q">
                        <div class="radios">
                            <div class="input-group">
                                <input type="radio" id="quartier-all" name="quartier_radio" data-filter="" value="" checked>
                                <label for="quartier-all">Tous</label>
                            </div>
                            {% for quartier in filters.quartiers %}
                                <div class="input-group">
                                    <input
                                        type="radio"
                                        id="quartier-{{ loop.index }}"
                                        name="quartier_radio"
                                        data-filter=".quartier-{{ quartier|replace({' ': '-'}) }}"
                                        value="{{ quartier }}"
                                    >
                                    <label for="quartier-{{ loop.index }}">{{ quartier }}</label>
                                </div>
                            {% endfor %}
                        </div>
                        <input type="hidden" name="filter_quartier" id="filter_quartier" readonly value="">
                    </div>
                </div>
            </div>
            <div class="width-placeholder">
                <div class="etat filter-container">
                    <button class="button-e" type="button">
                        <label for="etat_radio">Statut</label>
                    </button>
                    <div class="hidden-part-e">
                        <div class="radios">
                            <div class="input-group">
                                <input type="radio" id="etat-all" name="etat_radio" data-filter="" value="" checked>
                                <label for="etat-all">Tous</label>
                            </div>
                            {% for valeur, etat in filters.etats %}
                                <div class="input-group">
                                    <input
                                        type="radio"
                                        id="etat-{{ loop.index }}"
                                        name="etat_radio"
                                        data-filter=".etat-{{ valeur }}"
                                        value="{{ valeur }}"
                                    >
                                    <label for="etat-{{ loop.index }}">{{ etat }}</label>
                                </div>
                            {% endfor %}
                        </div>
                        <input type="hidden" name="filter_etat" id="filter_etat" readonly value="">
                    </div>
                </div>
            </div>

            {# Hidden range inputs expected by the shared filtering JS #}
            <input type="hidden" id="filter_prix_min" value="0">
            <input type="hidden" id="filter_prix_max" value="999999999">
            <input type="hidden" id="filter_surface_min" value="0">
            <input type="hidden" id="filter_surface_max" value="999999">
            <input type="hidden" id="filter_nb_pieces_min" value="0">
            <input type="hidden" id="filter_nb_pieces_max" value="999">
        </div>

        <div class="wrapper-annonces container">
            {% for projet in projets %}
                {% set quartier = projet.meta('acf_annonce_quartier') %}
                {% set type_bien = projet.meta('acf_annonce_famille_de_bien') %}
                {% set etat = projet.meta('acf_annonce_etat') %}
                {% set image = projet.meta('acf_annonce_image') %}
                {% set lien = projet.meta('acf_annonce_lien') %}
                <article
                    class="annonce quartier-{{ quartier|default('')|replace({' ': '-'}) }}"
                    data-type="{{ type_bien|default('') }}"
                    data-quartier="{{ quartier|default('') }}"
                    data-etat="{{ etat|default('') }}"
                    data-prix="0"
                    data-surface="0"
                    data-nb-piece="0"
                >
                    <div class="left">
                        {% if projet.meta('acf_annonce_bandeau') %}
                            <div class="bandeau-annonce"><span>{{ projet.meta('acf_annonce_bandeau') }}</span></div>
                        {% endif %}
                        <div class="photo" style="background-image: url({{ image }});"></div>
                    </div>
                    <div class="right">
                        <h5 class="title-annonce">{{ projet.title() }}</h5>
                        {% if quartier %}
                            <p class="quartier-name"><img src="/wp-content/themes/daudin/fonts/material-icons/location_on.svg" alt="Localisation" class="picto-icon" loading="lazy">{{ quartier }}</p>
                        {% endif %}

                        {% if projet.meta('acf_annonce_description') %}
                            <p class="description-annonce">{{ projet.meta('acf_annonce_description')|nl2br }}</p>
                        {% endif %}

                        {% if projet.meta('acf_annonces_pictos') %}
                            <ul class="pictos-list">
                                {% for picto in projet.meta('acf_annonces_pictos') %}
                                    {% if picto.item %}
                                        {% set icon_name = '' %}
                                        {% if picto.item.picto == 'surface' %}
                                            {% set icon_name = 'aspect_ratio' %}
                                        {% elseif picto.item.picto == 'prix' %}
                                            {% set icon_name = 'sell' %}
                                        {% elseif picto.item.picto == 'pieces' %}
                                            {% set icon_name = 'nest_multi_room' %}
                                        {% endif %}
                                        <li class="picto-item picto-{{ picto.item.picto|default('default') }}">
                                            {% if icon_name %}
                                                <img
                                                    src="/wp-content/themes/daudin/fonts/material-icons/{{ icon_name }}.svg"
                                                    alt="{{ picto.item.picto }}"
                                                    class="picto-icon"
                                                    loading="lazy"
                                                >
                                            {% endif %}
                                            {% if picto.item.texte %}
                                                <span class="picto-text">{{ picto.item.texte }}</span>
                                            {% endif %}
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        {% endif %}

                        {% if lien.url %}
                            <a href="{{ lien.url }}" class="button" target="_blank" rel="noopener">
                                {{ lien.label|default('En savoir plus') }}
                            </a>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>

    {% include "footer-page.twig" %}

    <style>
        body, .main_content, header a.hdr-logo-link::before {
            background-color: {{ page.meta("acf_page_bg_color") }};
            color: {{ page.meta("acf_page_text_color") }};
        }

        header a.hdr-logo-link span.hdr-logo, header nav a, header nav a:visited, .progression-indicator p {
            color: {{ page.meta("acf_page_text_color") }};
        }

        button, .button {
            border-color: {{ page.meta("acf_page_text_color") }};
        }
    </style>
{% endblock %}
