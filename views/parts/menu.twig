  data-reseaux-sociaux='{{ fields_footer.acf_conf_menu_fs.acf_reseaux_sociaux | json_encode }}'
>
  {{ load_nav_menu(wp.menus.main) }}
  <style>
    .menu_container > div  > ul > li:nth-child(1) {
      background-color: {{ fields_footer.acf_conf_menu_fs.color_part_1 }};
