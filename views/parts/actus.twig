{% set closedClass = fields_header.acf_open_on_load == 'non' ? 'actus--is-closed' : '' %}
{% set prevNextClass = fields_header.acf_actus|length < 2 ? 'actus__prev-next--hidden' : '' %}

{% if fields_header.acf_actus %}

<div class="actus {{ closedClass }}"> <!-- actus--only-small --> <!---->
    
    <button class="actus-trigger">
        <svg id="Calque_1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 35.21 35.21"><path d="m34.21,0c-.55,0-1,.45-1,1v30.79L2.71,1.29c-.39-.39-1.02-.39-1.41,0s-.39,1.02,0,1.41l30.5,30.5H1c-.55,0-1,.45-1,1s.45,1,1,1h34.21V1c0-.55-.45-1-1-1Z"/></svg>
    </button>
    <div class="actus__prev-next {{ prevNextClass }}">
        {{ count }}
        <button class="actus__prev"><</button>
        <button class="actus__next">></button>
    </div>
    <div class="actus-slider swiper">
        <div class="swiper-wrapper">
            
            {% for item in fields_header.acf_actus  %}
            {% set slideClass = item.image|length ? '' : 'actu--no-img' %}
            {% set slideBtnClass = item.lien|length ? '' : 'actu--no-btn' %}

            <div class="actu swiper-slide {{ slideClass }} {{ slideBtnClass }}">
                <div class="actu__img">
                    <div class="actu__img__mask">
                        {% if item.image %}
                            <img src="{{ item.image.url }}" alt="">
                        {% endif %}
                    </div>
                </div>
                <div class="actu__content">
                    <div class="actu__top">
                        <h2 class="actu__title"><span>{{ item.titre }}</span></h2>
                        {% if item.details %}
                        <p>{{ item.details }}</p>
                        {% endif %}
                    </div>
                    {% if item.lien %}
                    <a href="{{ item.lien.url }}" class="actu__cta button">{{ item.lien.title }}</a>
                    {% endif %}
                </div>
            </div>

            {% endfor %}

        </div>
    </div>
</div>


<style>

    .actus {
        position: fixed;
        /* bottom: 86.5px; */
        /* bottom: 107px; */
        bottom: calc(6 * var(--vh) + 30px);
        right: 30px;
        width: 800px;
        min-height: 400px;
        border-top-right-radius: 200px;
        overflow: hidden;
        transition: all .5s cubic-bezier(.65,.05,.36,1);
        {# z-index: 10; #}
    }
    
    .actus--only-small {
        width: 400px;
    }

    .actus--is-closed {
        width: 50px;
        min-height: 50px;
        border-top-right-radius: 25px;
        border-top-left-radius: 25px;
    }

    .actus-slider {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 800px;
        min-height: 400px;
        transition: all .5s ease-out;
    }

    .actus--only-small .actus-slider {
        width: 400px;
    }

    /* .actus--is-closed .actus-slider {
        opacity: 0;
    } */

    .actu {
        display: flex;
        width: 100%;
        height: 400px;
    }

    .actu__img {
        flex: 0 0 50%;
        padding: 30px 15px 30px 30px;
        background-color: #FD6F00;
    }

    .actu--no-img .actu__img {
        opacity: 0;
        visibility: hidden;
        
    }

    .actus--only-small .actu__img {
        display: none;
    }

    .actu__content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        flex: 0 0 50%;
        padding: 50px 30px 30px 15px;
        border-top-right-radius: 200px;
        background-color: #FD6F00;
        text-align: center;
    }

    .actu--no-btn .actu__content {
        justify-content: center;
    }

    .actu--no-img .actu__content {
        padding: 50px 30px 30px 30px;
        border-top-left-radius: 200px;
    }

    .actus--only-small .actu__content {
        flex: 0 0 100%;
    }   

    .actu__img__mask {
        height: 100%;
        aspect-ratio: 1/1;
        border-radius: 50%;
        overflow: hidden;
    }

    .actu__img__mask img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .actu__top {
        width: 100%;
    }

    .actu__title {
        text-align: center;
        font-family: "Teodor","Times New Roman",serif;
        font-weight: 300;
    }

    .actu__title span {
        display: inline-block;
        width: 75%;
        font-size: 4rem;
        line-height: 1em;
        letter-spacing: 0.06rem;  
        font-family: "Teodor","Times New Roman",serif;
        font-weight: 300;
        margin-bottom: .5em;
    }

    .actus p {
        font-size: 1.8rem;
    }

    .actu__cta.actu__cta {
        border: 1px solid black;
        color: black;
    }

    .actu__cta.actu__cta:hover {
        background-color: white!important;
    }

    .actus__prev-next {
        position: absolute;
        bottom: 30px;
        right: calc(50% - 10px);
        transform: translate3d(100%, 0, 0);
        transition: all .5s ease-out .5s;
        z-index: 10;
    }

    .actus__prev-next button {
        border-color: black!important;
        color: black!important;
    }

    .actus__prev-next--hidden {
        display: none;
    }

    .actus--is-closed .actus__prev-next {
        opacity: 0;
        transition: all 0s ease-out 0s;
    }

    .actus__prev.actus__prev,
    .actus__next.actus__next {
        padding: .5rem 1rem;
        font-size: 2.2rem;
        line-height: 1.9rem;
    }

    .actus__prev.actus__prev:hover,
    .actus__next.actus__next:hover {
        background-color: white;
    }

    .actus__next {

    }

    .actus-trigger {
        position: absolute;
        bottom: 0;
        right: 0;
        z-index: 20;
        width: 50px;
        height: 75px;
        border: none;
        border-radius: 0;
    }

    .actus-trigger svg {
        position: absolute;
        display: block;
        width: calc(100% - 30px);
        bottom: 10px;
        left: 20px;
        transform: rotate(0deg);
        transition: all .25s ease-in-out;
    }

    .actus--is-closed .actus-trigger svg {
        transform: rotate(180deg);
        opacity: 0;
    }

    .actus--is-closed .actus-trigger:hover svg {
        opacity: 1;
    }

    @media (max-width: 992px) {
        .actus {
            right: 10px;
            bottom: calc(6 * var(--vh) + 10px);
        }

        .actus,
        .actus-slider {
            width: 400px;
        }

        .actu__title span {
            font-size: 3.5rem;
        }

        .actus--is-closed {
            width: 50px;
            min-height: 50px;
            border-top-right-radius: 25px;
            border-top-left-radius: 25px;
        }

        .actus .actu__content {
            flex: 0 0 100%;
            border-top-left-radius: 200px;
        } 

        .actus .actu__img {
            display: none;
        }

        .actus__prev-next {
            right: unset;
            left: 10px;
            transform: none;
        }

    }

    @media (max-width: 767px){

        .actus {
            bottom: 116px;
            bottom: calc(8 * var(--vh) + 10px);   
        }

        .actus,
        .actus-slider {
            width: 350px;
            border-top-left-radius: 175px;
            border-top-right-radius: 175px;
        }

        .actus--is-closed {
            width: 50px;
        }
    }


</style>

{% endif %}