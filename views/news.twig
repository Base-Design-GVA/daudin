{% extends "base.twig" %}

{% block content %}

    <section class="page_content container">
        <div class="news">
            <ul class="news-list">
                {% for post in posts %}
                <li class="news-item" style="background-color: {{ post.meta('couleur') }};">
                    <a class="news-item__link" href="{{ post.link }}" title="{{ post.title }}"></a>
                    <div class="news-item__in">
                        <div class="news-item__top">
                            <h2 class="news-item__title">{{ post.title }}</h2>
                            <time class="news-item__time">{{ post.post_date|date("d.m.y") }}</time>
                        </div>
                        <div class="news-item__bottom">
                            <div class="news-item__excerpt"><p>{{ post.preview.length(20).force }}</p></div>
                            <div class="news-item__read-more"><span>Lire l'article</span></div>
                        </div>
                    </div>
                </li>
                {% endfor %}
            </ul>
        </div>
        {{ context }}
    </section>

    {% include "footer-page.twig" %}

    <style>
        body, .main_content, .bg_header {
            background-color: {{ page.meta("acf_page_bg_color") }};
            color: {{ page.meta("acf_page_text_color") }};
        }

        header {
            --color-inactive-link: {{ page.meta("acf_couleur_titre_inactif")}};
        }

        header nav a, header nav a:visited, .progression-indicator p {
            color: {{ page.meta("acf_page_text_color") }};
        }

        #daudin-title {
            fill : {{ page.meta("acf_page_text_color") }};
        }

        html body button, html body .button {
            border-color: {{ page.meta("acf_page_text_color") }};
            color: {{ page.meta("acf_page_text_color") }};
        }

        html body .bloc-faq-services .element {
            border-bottom-color: {{ page.meta("acf_page_text_color") }};
        }

        html body button::before, html body button::after, html body .button::before, html body .button::after {
            background-color: {{ page.meta("acf_page_text_color") }};
        }

        .left-page .bg_transition {
            background-color: {{ fields_header.acf_conf_header_principal_content.left_part.bg_color_page_lie }};
        }

        .right-page .bg_transition {
            background-color: {{ fields_header.acf_conf_header_principal_content.right_part.bg_color_page_lie }};
        }

        .news {
            container-type: inline-size;
        }

        .news-list {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-column-gap: 40px;
            grid-row-gap: 40px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .news-item {
            position: relative;
            width: 100%;
            aspect-ratio: 1/1;
            padding: 20px;
        }

        .news-item__link {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
        }

        .news-item__in {
            display: flex;
            height: 100%;
            flex-direction: column;
            justify-content: space-between;
        }

        .news-item__top {

        }

        .news-item__title {
            font-family: 'Teodor','Times New Roman',serif;
            font-weight: 300;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2; /* number of lines to show */
                    line-clamp: 2; 
            -webkit-box-orient: vertical;
        }

        .news-item__time {

        }

        .news-item__bottom {

        }

        .news-item__excerpt {
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 3; /* number of lines to show */
                    line-clamp: 3; 
            -webkit-box-orient: vertical;
        }

        .news-item__excerpt .read-more {
            display: none;
        }

        .news-item__read-more {
            display: flex;
            justify-content: center;
        }

        .news-item__read-more span {
            border: 1px solid black;
            border-radius: 200px;
            padding: 1rem 2rem;
            font-size: 2.2rem;
            line-height: 2.9rem;
            margin-top: 1em;
            transition: all .25s ease-in-out;
        }

        .news-item__link:hover + .news-item__in span {
            background-color: white;
        }

        @media screen and (max-width: 2200px){
            .news-list {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media screen and (max-width: 1750px){
            .news-list {
                grid-template-columns: repeat(2, 1fr);
            }

            .news-item {
                padding: 30px;
            }
        }

        @media screen and (max-width: 1330px){
            .news-list {
                grid-template-columns: repeat(1, 1fr);
            }
        }

        @media screen and (max-width: 1279px){
            .news-list {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media screen and (max-width: 768px){
            .news-list {
                grid-template-columns: repeat(1, 1fr);
            }
        }


    </style>
{% endblock %}
